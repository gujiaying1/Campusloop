generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingCategory {
  ELECTRONICS
  FURNITURE
  TEXTBOOKS
  CLOTHING
  HOME_LIVING
  OTHER
}

enum ListingCondition {
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  passwordHash String?
  createdAt DateTime  @default(now())
  listings  Listing[]
  favourites Favourite[]
  buyerConversations Conversation[] @relation("ConversationBuyer")
  sellerConversations Conversation[] @relation("ConversationSeller")
  sentMessages Message[]
}

model Listing {
  id          Int              @id @default(autoincrement())
  title       String
  description String
  priceCents  Int
  category    ListingCategory
  condition   ListingCondition
  location    String
  status      ListingStatus    @default(AVAILABLE)
  seller      User             @relation(fields: [sellerId], references: [id])
  sellerId    Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  favourites  Favourite[]
  conversations Conversation[]

  @@unique([sellerId, title])
}

model Favourite {
  userId    Int
  listingId Int
  createdAt DateTime @default(now())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  listingId Int
  buyerId   Int
  sellerId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User     @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([listingId, buyerId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
